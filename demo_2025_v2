import java.io.*;

public class InsecureDeserializationExample {
    public static void main(String[] args) {
        // Assume 'malicious_input.ser' is a file created by an attacker
        // containing a serialized object designed to exploit the application.
        try {
            FileInputStream fis = new FileInputStream("malicious_input.ser");
            ObjectInputStream ois = new ObjectInputStream(fis);

            // The vulnerability is in blindly calling readObject() on untrusted data.
            Object obj = ois.readObject(); // This is where the exploit can be executed
            ois.close();
            fis.close();
            System.out.println("Object deserialized: " + obj);

        } catch (IOException | ClassNotFoundException e) {
            e.printStackTrace();
        }
    }
}

import java.sql.Connection;
import java.sql.DriverManager;
import java.sql.ResultSet;
import java.sql.SQLException;
import java.sql.Statement;

public class InsecureSQLInjectionExample {
    public static void main(String[] args) {
        String username = "admin' OR '1'='1"; // Malicious input

        // Insecure query: input is directly concatenated into the SQL string
        String query = "SELECT * FROM users WHERE username = '" + username + "'";

        try (Connection conn = DriverManager.getConnection("jdbc:mysql://localhost/testdb", "dbuser", "dbpassword");
             Statement stmt = conn.createStatement();
             ResultSet rs = stmt.executeQuery(query)) { // The insecure query is executed
            
            while (rs.next()) {
                System.out.println("User found: " + rs.getString("username"));
            }
        } catch (SQLException e) {
            e.printStackTrace();
        }
    }
}
